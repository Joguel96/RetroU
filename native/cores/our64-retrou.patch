+void retrou_list(const roms_view & rv)
+{
+	const int selected_game = rv.shown[rv.sel];
+	box(ru(42), ru(130), ru(425), ru(470), RU_PANEL, 11);
+	retrou_cover(rv, selected_game, ru(75), ru(160), ru(355), ru(380));
+	if (rv.games[selected_game].favorite)
+		text(ru(441), ru(161), "★", 17, RU_GOLD, GUI_TEXT_JUSTIFY_CENTER);
+	for (int k = 0; k < rv.visible && k < 5; k++) {
+		int at = rv.first + k, game = rv.shown[at];
+		const library_game & g = rv.games[game];
+		float y = ru(142 + k * 90);
+		const bool selected = at == rv.sel;
+		box(ru(500), y, ru(730), ru(78), selected ? RU_SELECTED_ROW : RU_CARD, 8);
+		int title_px = fit(g.title, 16, 13, int(ru(670)));
+		std::string title = cut_to_fit(g.title, title_px, int(ru(670)));
+		text(ru(522), y + 8, title.c_str(), title_px, selected ? RU_WHITE : RU_MUTED);
+		text(ru(522), y + 30, "Nintendo 64", 10, RU_MUTED);
+		if (g.favorite) text(ru(1195), y + 13, "★", 17, RU_GOLD, GUI_TEXT_JUSTIFY_CENTER);
+	}
+}
+
+void retrou_carousel(const roms_view & rv)
+{
+	const int selected_game = rv.shown[rv.sel];
+	if (rv.sel > 0)
+		retrou_cover(rv, rv.shown[rv.sel - 1], ru(40), ru(258), ru(270), ru(204));
+	if (rv.sel + 1 < rv.count)
+		retrou_cover(rv, rv.shown[rv.sel + 1], ru(970), ru(258), ru(270), ru(204));
+	box(ru(295), ru(130), ru(690), ru(450), RU_PANEL, 13);
+	retrou_cover(rv, selected_game, ru(308), ru(143), ru(664), ru(424));
+	if (rv.games[selected_game].favorite)
+		text(ru(950), ru(162), "★", 18, RU_GOLD, GUI_TEXT_JUSTIFY_CENTER);
+	box(ru(300), ru(590), ru(680), ru(64), RU_CARD, 8);
+	const char *title = rv.games[selected_game].title;
+	int title_px = fit(title, 17, 14, int(ru(630)));
+	std::string label = cut_to_fit(title, title_px, int(ru(630)));
+	text(ru(325), ru(605), label.c_str(), title_px, RU_WHITE);
+	char count[44];
+	snprintf(count, sizeof(count), "%d / %d juegos", rv.sel + 1, rv.count);
+	text(ru(1020), ru(610), count, 11, RU_MUTED);
+}
+
+void retrou_search(const roms_view & rv)
+{
+	if (!rv.searching) return;
+	box(0, 0, UI_W, UI_H, PixelColor{0, 0, 0, 180});
+	char query[80];
+	snprintf(query, sizeof(query), "%s_", rv.search);
+	text(ru(200), ru(60), rv.search[0] ? query : "Buscar...", 16, RU_WHITE);
+	static const char chars[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+	for (int i = 0; i < 39; i++) {
+		int row = i / 6, col = i % 6;
+		float x = ru(150 + col * 100), y = ru(130 + row * 58);
+		bool selected = i == rv.bar_focus;
+		box(x, y, ru(90), ru(48), selected ? RU_ACCENT : RU_CARD, 5);
+		char key[2] = {i < 36 ? chars[i] : ' ', 0};
+		const char *label = i == 36 ? "Esp" : i == 37 ? "<" : i == 38 ? "OK" : key;
+		text(x + ru(45), y + 7, label, 13, selected ? RU_CARD : RU_WHITE, GUI_TEXT_JUSTIFY_CENTER);
+	}
+}
+
+void draw_roms(const ui_view & v)
+{
+	const roms_view & rv = *v.roms;
+	retrou_backdrop(rv);
+	text(ru(28), ru(18), "Biblioteca", 23, RU_WHITE);
+	if (rv.count > 0) {
+		const char *title = rv.games[rv.shown[rv.sel]].title;
+		int title_px = fit(title, 14, 12, 450);
+		std::string label = cut_to_fit(title, title_px, 450);
+		text(815, ru(26), label.c_str(), title_px, RU_MUTED, GUI_TEXT_JUSTIFY_RIGHT);
+	}
+	retrou_bar(rv);
+	if (rv.count <= 0) {
+		const char *message = rv.search[0] ? "Sin resultados" : rv.missing ? "Carpeta de ROMs no disponible" : "No hay juegos";
+		text(UI_W / 2, 205, message, 20, RU_WHITE, GUI_TEXT_JUSTIFY_CENTER);
+		if (rv.notice[0]) text(UI_W / 2, 244, rv.notice, 12, RU_MUTED, GUI_TEXT_JUSTIFY_CENTER);
+	} else if (rv.layout == ROMS_GRID) retrou_grid(rv);
+	else if (rv.layout == ROMS_LIST) retrou_list(rv);
+	else retrou_carousel(rv);
+	const bool remote = rv.glyphs == INPUT_WIIMOTE || rv.glyphs == INPUT_NUNCHUK;
+	text(ru(28), ru(672), "A  JUGAR", 11, RU_MUTED);
+	text(ru(230), ru(672), remote ? "-  FAVORITO" : "X  FAVORITO", 11, RU_MUTED);
+	if (!remote) {
+		text(ru(475), ru(672), "Y  VISTA", 11, RU_MUTED);
+		text(ru(665), ru(672), "-  BUSCAR", 11, RU_MUTED);
+	}
+	text(ru(remote ? 670 : 840), ru(672), "+  AJUSTES", 11, RU_MUTED);
+	if (rv.layout != ROMS_CAROUSEL) {
+		char count[44];
+		snprintf(count, sizeof(count), "%d / %d", rv.count ? rv.sel + 1 : 0, rv.count);
+		text(ru(1230), ru(672), count, 11, RU_MUTED, GUI_TEXT_JUSTIFY_RIGHT);
+	}
+	if (rv.download_total > rv.download_done) {
+		char progress[64];
+		snprintf(progress, sizeof(progress), "Portadas %d/%d", rv.download_done, rv.download_total);
+		text(820, 34, progress, 10, RU_MUTED, GUI_TEXT_JUSTIFY_RIGHT);
+	}
+	retrou_search(rv);
 }
 

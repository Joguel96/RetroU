diff --git a/tools/build-retrou-n64.sh b/tools/build-retrou-n64.sh
new file mode 100644
index 0000000000000000000000000000000000000000..550f3d5666258e2ff9aab0e24b43217fbe0c4eea
--- /dev/null
+++ b/tools/build-retrou-n64.sh
@@ -0,0 +1,60 @@
+#!/usr/bin/env bash
+# Build RetroU N64 from Our64 and stage the WUHB with a traceable log.
+# Usage: bash tools/build-retrou-n64.sh [path-to-RetroU]
+set -euo pipefail
+
+HERE="$(cd "$(dirname "$0")" && pwd)"
+ROOT="$(cd "$HERE/.." && pwd)"
+RETROU="${1:-/c/proyectos/RetroU}"
+LOG_DIR="$ROOT/player/build-release/logs"
+mkdir -p "$LOG_DIR"
+STAMP="$(date -u +%Y%m%d-%H%M%S)"
+LOG_FILE="$LOG_DIR/build-$STAMP.log"
+exec > >(tee "$LOG_FILE") 2>&1
+
+finish() {
+    result=$?
+    printf 'BUILD_RESULT=%s\nLOG_FILE=%s\n' "$result" "$LOG_FILE"
+}
+trap finish EXIT
+
+echo "RetroU N64 build started: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
+echo "Our64 revision: $(git -C "$ROOT" rev-parse HEAD)"
+echo "RetroU path: $RETROU"
+echo "Our64 working tree:"
+git -C "$ROOT" -c core.autocrlf=true status --short
+echo "Key source checksums:"
+sha256sum "$ROOT/player/Makefile" "$ROOT/player/source/video.cpp" \
+    "$ROOT/third_party/gliden64/src/Graphics/GX2Context/gx2_GL.cpp" \
+    "$ROOT/third_party/libgui/source/drivers/wut/WutInputDriver.cpp" \
+    "$ROOT/third_party/libgui/source/drivers/wut/WutThreadDriver.cpp" "$0"
+
+SOURCE="$ROOT/player/release/our64.wuhb"
+DEST_DIR="$RETROU/dist/wiiu/apps/RetroN64U"
+DEST="$DEST_DIR/RetroN64U.wuhb"
+if [ -f "$DEST" ]; then
+    echo "Previous staged WUHB: $(sha256sum "$DEST")"
+fi
+
+# CafeGLSL: fetch the Wii U PPC prebuilt only if missing.
+if [ ! -f "$ROOT/third_party/cafeglsl/lib/libcafeglsl.a" ]; then
+    echo "Fetching CafeGLSL"
+    bash "$ROOT/tools/fetch-cafeglsl.sh"
+fi
+
+echo "Running: make -C $ROOT/player RELEASE=1"
+make -C "$ROOT/player" RELEASE=1
+test -s "$SOURCE"
+echo "Built WUHB: $(sha256sum "$SOURCE")"
+
+mkdir -p "$DEST_DIR"
+if [ -f "$DEST" ]; then
+    cp -p "$DEST" "$DEST_DIR/RetroN64U.previous.wuhb"
+    echo "Rollback WUHB: $DEST_DIR/RetroN64U.previous.wuhb"
+fi
+cp "$SOURCE" "$DEST.tmp"
+cmp "$SOURCE" "$DEST.tmp"
+mv -f "$DEST.tmp" "$DEST"
+cmp "$SOURCE" "$DEST"
+echo "Staged WUHB: $(sha256sum "$DEST")"
+echo "OK: $DEST"

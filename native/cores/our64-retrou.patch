+/* Search is applied to the current category without changing the original
+ * game indices. Only the visible window is sent to the graphics thread. */
+static int search_match(const char *title, const char *query)
+{
+	if (!query[0]) return 1;
+	for (; *title; title++) {
+		const char *a = title, *b = query;
+		while (*a && *b) {
+			char x = *a, y = *b;
+			if (x >= 'A' && x <= 'Z') x += 'a' - 'A';
+			if (y >= 'A' && y <= 'Z') y += 'a' - 'A';
+			if (x != y) break;
+			a++; b++;
+		}
+		if (!*b) return 1;
+	}
+	return 0;
+}
+
+static int search_filter(int count)
+{
+	int out = 0;
+	for (int i = 0; i < count; i++)
+		if (search_match(g_games[g_shown[i]].title, g_view.search))
+			g_shown[out++] = g_shown[i];
+	return out;
+}

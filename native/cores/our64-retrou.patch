diff --git a/bench/source/report.c b/bench/source/report.c
index 4d51969d3ca1a5911a3a85a9dc6fe8cadae6db7c..3459b8599dea854130626dff2e47072bdac6b253 100644
--- a/bench/source/report.c
+++ b/bench/source/report.c
@@ -6,6 +6,7 @@
 #include <whb/log_console.h>
 #include <whb/sdcard.h>
 
+#include <errno.h>
 #include <stdarg.h>
 #include <stdio.h>
 #include <string.h>
@@ -35,6 +36,7 @@ static const char *const g_keep_prefix[] = {
 	"Our64 ", "OUR ROMS: play ", "Playing ", "GAME: ", "ERROR ", "CRASH", "FAILED", "SAVE FAILED",
 	"RESUME FAILED", "SLOW SD", "WATCHDOG", "STALL", "SYSTEM:", "MEMORY:", "GLideN64:", "TPAK: SAVE NOT WRITTEN",
 	"Closing after", "No sound", "No JIT area", "Graphics did not start", "Core variables",
+	"INPUT:", "PAUSE:", "ASSETS:",
 };
 static bool g_keep_indented;
 
@@ -107,13 +109,27 @@ const char *report_sd_root(void)
 	if (!g_tried) {
 		g_tried = true;
 		if (WHBMountSdCard()) {
-			g_mounted = true;
-			snprintf(g_root, sizeof(g_root), "%s/wiiu", WHBGetSdCardMountPath());
-			mkdir(g_root, 0777);
-			snprintf(g_root, sizeof(g_root), "%s/wiiu/our64", WHBGetSdCardMountPath());
-			mkdir(g_root, 0777);
-			snprintf(g_path, sizeof(g_path), "%s/" REPORT_FILE, g_root);
+			const char *mount = WHBGetSdCardMountPath();
+#ifdef OUR64_RELEASE
+			const char *parent = "retrou";
+			const char *home = "retrou/n64";
+#else
+			const char *parent = "wiiu";
+			const char *home = "wiiu/our64";
+#endif
+			int n = snprintf(g_root, sizeof(g_root), "%s/%s", mount, parent);
+			if (n > 0 && (size_t)n < sizeof(g_root) &&
+			    (mkdir(g_root, 0777) == 0 || errno == EEXIST)) {
+				n = snprintf(g_root, sizeof(g_root), "%s/%s", mount, home);
+				if (n > 0 && (size_t)n < sizeof(g_root) &&
+				    (mkdir(g_root, 0777) == 0 || errno == EEXIST)) {
+					n = snprintf(g_path, sizeof(g_path), "%s/" REPORT_FILE, g_root);
+					g_mounted = n > 0 && (size_t)n < sizeof(g_path);
+				}
+			}
 		}
+		if (!g_mounted)
+			report_line("ERROR SD mount or data directory failed for N64 (errno %d)", errno);
 	}
 	return g_mounted ? g_root : NULL;
 }
diff --git a/player/Makefile b/player/Makefile
index 3fa62108d74022bcad9b82a3647a57c4b24058a0..3c6b5be30b74574b6595061a84e338a2b521e9cb 100644
--- a/player/Makefile
+++ b/player/Makefile
@@ -10,17 +10,14 @@ ifeq ($(strip $(DEVKITPRO)),)
 $(error "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>/devkitpro")
 endif
 
-APP_NAME	:= Our64
-APP_SHORTNAME	:= Our64
-APP_AUTHOR	:= Our64
-
-# The public build's icon is the grey N64 controller (tools/make-icon.sh
-# our64); the developer's own build keeps the cat (Zach, 2026-10-30).
-ifeq ($(RELEASE),1)
-APP_ICON	:=	$(CURDIR)/../meta/icon.png
-else
-APP_ICON	:=	$(CURDIR)/../replay/meta/icon-gx2.png
-endif
+APP_NAME	:= RetroU N64
+APP_SHORTNAME	:= RetroU N64
+APP_AUTHOR	:= joguel96
+
+# RetroU N64's metadata and splash images are independent of the GX2 apps.
+APP_ICON	:=	$(CURDIR)/../assets/console/n64/icon.png
+APP_TV_SPLASH	:=	$(CURDIR)/../assets/console/n64/tv-splash.png
+APP_DRC_SPLASH	:=	$(CURDIR)/../assets/console/n64/drc-splash.png
 include $(DEVKITPRO)/wut/share/wut_rules
 
 GFX		:=	gx2
@@ -54,10 +51,12 @@ ifeq ($(RELEASE),1)
 TARGET		:=	release/our64
 BUILD		:=	build-release
 REL_DEFINES	:=	-DOUR64_RELEASE
+PLAYER_LOG	:=	retrou_n64.log
 else
 TARGET		:=	our64
 BUILD		:=	build
 REL_DEFINES	:=
+PLAYER_LOG	:=	player-log.txt
 endif
 
 # The same Not64 core as the bench, minus nothing.
@@ -153,7 +152,7 @@ $(BUILD)/not64/%.o: $(NOT64)/%.c
 $(BUILD)/bench/%.o: $(BENCH)/source/%.c
 	@mkdir -p $(dir $@)
 	@echo $*.c
-	@$(CC) -MMD -MP $(CFLAGS) -std=gnu23 -DREPORT_NO_CONSOLE -DREPORT_FILE='"player-log.txt"' -c $< -o $@
+	@$(CC) -MMD -MP $(CFLAGS) -std=gnu23 -DREPORT_NO_CONSOLE -DREPORT_FILE='"$(PLAYER_LOG)"' -c $< -o $@
 # main.c's log header names the build (__DATE__ __TIME__): it is compiled
 # again whenever any other part changed, so the header matches what runs.
 $(BUILD)/source/main.o: $(filter-out $(BUILD)/source/main.o,$(OFILES)) $(LIBGUI_A)
